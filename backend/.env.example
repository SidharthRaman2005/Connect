# Backend environment configuration.
# Copy this file to ".env" (same folder) and fill in the values.
# ".env" is gitignored, so real credentials never get committed.

# JDBC URL for the PostgreSQL "connect" database (create it once; see db/init.sql).
DB_URL=jdbc:postgresql://localhost:5432/connect

# Database user. For local dev you can use the built-in "postgres" superuser,
# or a dedicated "connect_app" role (recommended — see db/init.sql).
DB_USERNAME=postgres

# Database password. REQUIRED. Put your real password only in .env, never here.
DB_PASSWORD=

# Comma-separated origins allowed to call the API (the Vite dev server).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth client ID — the audience the backend accepts on ID tokens.
# Must match the frontend's VITE_GOOGLE_CLIENT_ID. The client ID is public;
# the client SECRET must never be stored in the frontend.
GOOGLE_CLIENT_ID=504517063945-pno4gnbnrtf74av9409tvi1am8vglt7t.apps.googleusercontent.com

# Only verified emails ending exactly in this domain may sign in.
ALLOWED_EMAIL_DOMAIN=vitapstudent.ac.in

# HMAC secret used to sign session JWTs. Use a long random string (>= 32 chars).
# Leave blank for dev and the app generates a temporary key each startup
# (sessions won't survive a restart). Set a fixed value for stable sessions.
JWT_SECRET=
# Session lifetime in seconds (default 86400 = 24h).
JWT_EXPIRATION_SECONDS=86400
